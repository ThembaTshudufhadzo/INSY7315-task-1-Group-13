@{
    ViewData["Title"] = "Data Export";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Data Export</h1>
        <p class="page-subtitle">Export system records to CSV, Excel, or PDF for external reporting.</p>
    </div>
</div>

<div class="data-table-wrap" style="max-width: 800px; margin: 0 auto; padding: 24px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
        <!-- Left Col: Form -->
        <div>
            <h4 style="margin-top: 0; color: var(--text-main); font-weight: 600; margin-bottom: 16px;">Export Criteria</h4>
            
            <div class="mb-3">
                <label class="form-label" style="font-size: 0.85rem; font-weight: 500; color: var(--text-secondary);">Module</label>
                <select class="form-select">
                    <option>Quotations & Estimates</option>
                    <option>Projects & Operations</option>
                    <option>Invoices & Payments</option>
                    <option>User Audit Logs</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-size: 0.85rem; font-weight: 500; color: var(--text-secondary);">Date Range</label>
                <div style="display: flex; gap: 12px;">
                    <input type="date" class="form-control" value="2023-01-01" />
                    <input type="date" class="form-control" value="2023-12-31" />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label" style="font-size: 0.85rem; font-weight: 500; color: var(--text-secondary);">Format</label>
                <select class="form-select">
                    <option>CSV (Comma Separated)</option>
                    <option>Excel (.xlsx)</option>
                    <option>PDF Report</option>
                </select>
            </div>

            <button class="btn btn-primary w-100" onclick="showToast('Export started. You will be notified when the file is ready.')">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px; margin-right: 6px; display: inline-block; vertical-align: text-bottom;">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Generate Export
            </button>
        </div>

        <!-- Right Col: Recent Exports -->
        <div>
            <h4 style="margin-top: 0; color: var(--text-main); font-weight: 600; margin-bottom: 16px;">Recent Exports</h4>
            
            <div style="border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                <div style="padding: 12px 16px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #faf8f8;">
                    <div>
                        <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-main);">Q3 Quotes Report</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Generated today, 09:41 AM</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary">Download</button>
                </div>
                
                <div style="padding: 12px 16px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #faf8f8;">
                    <div>
                        <div style="font-weight: 600; font-size: 0.9rem; color: var(--text-main);">User Audit Log (Aug)</div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Generated yesterday, 16:30 PM</div>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary">Download</button>
                </div>
            </div>
        </div>
    </div>
</div>
