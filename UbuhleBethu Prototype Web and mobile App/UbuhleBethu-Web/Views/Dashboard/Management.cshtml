@model IEnumerable<UbuhlebethuConnectPro.Web.Models.Job>
@{
    ViewData["Title"] = "Management & Finance";
    decimal totalValue    = (decimal)(ViewBag.TotalValue ?? 0m);
    int    totalProjects  = (int)(ViewBag.TotalProjects ?? 0);
    decimal totalInvoiced = Model.Sum(j => j.InvoicedAmount);
    decimal outstanding   = totalValue - totalInvoiced;
    decimal avgBudget     = totalProjects > 0 ? totalValue / totalProjects : 0;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-title">Management &amp; Financial Dashboard</h1>
        <p class="page-subtitle">High-level financial reporting and project profitability overview</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary btn-sm" onclick="window.print()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
            </svg>
            Export
        </button>
        <button class="btn btn-primary btn-sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Schedule Report
        </button>
    </div>
</div>

<!-- Financial KPIs -->
<div class="kpi-grid">
    <div class="kpi-card kpi-blue">
        <div class="kpi-label">Total Projects</div>
        <div class="kpi-value">@totalProjects</div>
        <div class="kpi-sub">Active in current period</div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-label">Total Order Book</div>
        <div class="kpi-value" style="font-size:1.3rem;">R @totalValue.ToString("N0")</div>
        <div class="kpi-sub">Contracted project value</div>
    </div>
    <div class="kpi-card kpi-orange">
        <div class="kpi-label">Total Invoiced</div>
        <div class="kpi-value" style="font-size:1.3rem;">R @totalInvoiced.ToString("N0")</div>
        <div class="kpi-sub">Revenue recognised to date</div>
    </div>
    <div class="kpi-card kpi-red">
        <div class="kpi-label">Outstanding / Balance</div>
        <div class="kpi-value" style="font-size:1.3rem;">R @outstanding.ToString("N0")</div>
        <div class="kpi-sub">Remaining to invoice</div>
    </div>
</div>

<!-- Project Financial Table -->
<div class="data-table-wrap">
    <div class="data-table-header">
        <p class="data-table-title">Project Financial Summary</p>
        <div class="table-controls">
            <div class="table-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text" placeholder="Search..." id="mgmtSearch" oninput="mgmtFilter()" />
            </div>
        </div>
    </div>
    <div style="overflow-x:auto;">
        <table class="data-table" id="mgmtTable">
            <thead>
                <tr>
                    <th>Job Ref</th>
                    <th>Project / Client</th>
                    <th>Region</th>
                    <th>Type</th>
                    <th>Est. Budget</th>
                    <th>Invoiced</th>
                    <th>Outstanding</th>
                    <th>% Collected</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model)
                {
                    decimal pctCollected = j.EstimatedCost > 0 ? j.InvoicedAmount / j.EstimatedCost * 100 : 0;
                    decimal jobOutstanding = j.EstimatedCost - j.InvoicedAmount;
                    string collectedClass = pctCollected >= 70 ? "badge-success" : pctCollected >= 40 ? "badge-warning" : "badge-neutral";
                    string statusClass = j.Progress >= 80 ? "badge-success" : j.Progress >= 40 ? "badge-info" : "badge-neutral";
                    string statusLabel = j.Progress >= 80 ? "Near Completion" : j.Progress >= 40 ? "In Progress" : "Early Stage";

                    <tr>
                        <td>
                            <a asp-controller="Dashboard" asp-action="Details" asp-route-id="@j.Id"
                               class="td-primary" style="color:var(--color-primary);">@j.JobNumber</a>
                        </td>
                        <td>
                            <div class="td-primary">@j.ClientName</div>
                            <div class="small text-muted">@j.Description</div>
                        </td>
                        <td>@j.Location</td>
                        <td><span class="badge badge-neutral">@j.BuildingType</span></td>
                        <td class="fw-600">R @j.EstimatedCost.ToString("N0")</td>
                        <td style="color:var(--color-success); font-weight:600;">R @j.InvoicedAmount.ToString("N0")</td>
                        <td style="color:var(--color-warning); font-weight:600;">R @jobOutstanding.ToString("N0")</td>
                        <td style="min-width:120px;">
                            <div class="progress-bar-wrap">
                                <div class="progress-track">
                                    <div class="progress-fill @(pctCollected >= 70 ? "success" : pctCollected >= 40 ? "warning" : "muted")"
                                         style="width:@((int)pctCollected)%;"></div>
                                </div>
                                <span class="progress-pct">@((int)pctCollected)%</span>
                            </div>
                        </td>
                        <td><span class="badge @statusClass">@statusLabel</span></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="background:#fafbfc; border-top:2px solid var(--color-border);">
                    <td colspan="4" class="fw-600" style="padding:12px 16px; font-size:0.8rem;">
                        Portfolio Totals
                    </td>
                    <td class="fw-600" style="padding:12px 16px;">R @totalValue.ToString("N0")</td>
                    <td class="fw-600" style="color:var(--color-success); padding:12px 16px;">R @totalInvoiced.ToString("N0")</td>
                    <td class="fw-600" style="color:var(--color-warning); padding:12px 16px;">R @outstanding.ToString("N0")</td>
                    <td colspan="2" style="padding:12px 16px;"></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function mgmtFilter() {
        var q = document.getElementById('mgmtSearch').value.toLowerCase();
        document.querySelectorAll('#mgmtTable tbody tr').forEach(function(r) {
            r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }
</script>
}
