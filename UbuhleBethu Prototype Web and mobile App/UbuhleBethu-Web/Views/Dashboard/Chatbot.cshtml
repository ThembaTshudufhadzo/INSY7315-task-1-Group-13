@{
    ViewData["Title"] = "AI Support Assistant";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Support Assistant</h1>
        <p class="page-subtitle">Get instant help with quotations, operations, and general inquiries.</p>
    </div>
</div>

<div class="data-table-wrap" style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; height: 60vh;">
    <div class="data-table-header" style="border-bottom: 1px solid var(--border-color); padding: 16px 20px;">
        <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; border-radius: 50%; background: var(--color-primary); display: flex; align-items: center; justify-content: center; color: white;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <div>
                <div style="font-weight: 600; font-size: 1rem; color: var(--text-main);">ConnectPro AI</div>
                <div style="font-size: 0.8rem; color: var(--color-success);">Online</div>
            </div>
        </div>
    </div>

    <div style="flex: 1; padding: 20px; overflow-y: auto; background: #faf8f8; display: flex; flex-direction: column; gap: 16px;">
        <!-- Bot Message -->
        <div style="display: flex; gap: 12px; align-self: flex-start; max-width: 80%;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-primary); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: white;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <div style="background: white; padding: 12px 16px; border-radius: 12px; border-top-left-radius: 2px; box-shadow: var(--shadow-sm); font-size: 0.9rem; color: var(--text-secondary);">
                Hello! I'm the ConnectPro AI assistant. How can I help you today?
            </div>
        </div>

        <!-- User Message -->
        <div style="display: flex; gap: 12px; align-self: flex-end; max-width: 80%;">
            <div style="background: var(--color-primary); color: white; padding: 12px 16px; border-radius: 12px; border-top-right-radius: 2px; box-shadow: var(--shadow-sm); font-size: 0.9rem;">
                I need help tracking my quotation (Ref: Q-2023-104)
            </div>
        </div>

        <!-- Bot Message -->
        <div style="display: flex; gap: 12px; align-self: flex-start; max-width: 80%;">
             <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--color-primary); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: white;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
            </div>
            <div style="background: white; padding: 12px 16px; border-radius: 12px; border-top-left-radius: 2px; box-shadow: var(--shadow-sm); font-size: 0.9rem; color: var(--text-secondary);">
                Sure! Quotation <strong>Q-2023-104</strong> (Sandton Office Park Phase 2) is currently marked as <strong>Approved</strong>. The Office/QS team is preparing the initial invoice.<br/><br/>Would you like me to take you to the detailed tracking page?
                <div style="margin-top: 12px;">
                    <a href="/Quotation/Track" class="btn btn-sm btn-outline-primary">View Tracking</a>
                </div>
            </div>
        </div>
    </div>

    <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); background: white; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;">
        <div style="display: flex; gap: 12px;">
            <input type="text" class="form-control" placeholder="Type your message here..." style="flex: 1;" />
            <button class="btn btn-primary" onclick="showToast('Message sent')">Send</button>
        </div>
    </div>
</div>
