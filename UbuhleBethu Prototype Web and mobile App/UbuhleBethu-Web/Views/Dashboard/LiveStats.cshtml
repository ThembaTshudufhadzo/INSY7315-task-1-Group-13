@model IEnumerable<UbuhlebethuConnectPro.Web.Models.Job>
@{ ViewData["Title"] = "Live Statistics"; }

<div class="page-header">
    <div>
        <h1 class="page-title">Live Project Statistics</h1>
        <p class="page-subtitle">Real-time portfolio performance across all active sites</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Dashboard" asp-action="PortfolioView" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;margin-right:6px;">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            Portfolio View
        </a>
    </div>
</div>

<div class="kpi-grid" style="margin-bottom: 2rem;">
    <div class="kpi-card kpi-crimson">
        <div class="kpi-label">Total Sites</div>
        <div class="kpi-value">@(Model.Count())</div>
    </div>
    <div class="kpi-card kpi-green">
        <div class="kpi-label">Avg Progress</div>
        <div class="kpi-value">@(Model.Any() ? (int)Model.Average(j => j.Progress) : 0)%</div>
    </div>
    <div class="kpi-card kpi-orange">
        <div class="kpi-label">Total Value</div>
        <div class="kpi-value">R @(Model.Sum(j => j.EstimatedCost).ToString("N0"))</div>
    </div>
    <div class="kpi-card kpi-red">
        <div class="kpi-label">Total Invoiced</div>
        <div class="kpi-value">R @(Model.Sum(j => j.InvoicedAmount).ToString("N0"))</div>
    </div>
    <div class="kpi-card kpi-teal">
        <div class="kpi-label">Outstanding</div>
        <div class="kpi-value">R @((Model.Sum(j => j.EstimatedCost) - Model.Sum(j => j.InvoicedAmount)).ToString("N0"))</div>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
    <div class="card">
        <div class="card-header">
            <h3 style="margin: 0;">Progress by Site</h3>
        </div>
        <div class="card-body">
            <table style="width: 100%; border-collapse: collapse;">
                @foreach (var job in Model)
                {
                    <tr>
                        <td style="padding: 0.5rem 0;">@job.JobNumber - @job.Description</td>
                        <td style="width: 40%;">
                            <div class="progress-bar-wrap">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @job.Progress%;"></div>
                                </div>
                                <span class="progress-pct">@job.Progress%</span>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h3 style="margin: 0;">Collection Rate</h3>
        </div>
        <div class="card-body">
            <table style="width: 100%; border-collapse: collapse;">
                @foreach (var job in Model)
                {
                    var collectionPct = job.EstimatedCost > 0 ? (int)((job.InvoicedAmount / job.EstimatedCost) * 100) : 0;
                    <tr>
                        <td style="padding: 0.5rem 0;">@job.JobNumber</td>
                        <td style="width: 40%;">
                            <div class="progress-bar-wrap">
                                <div class="progress-track">
                                    <div class="progress-fill" style="width: @collectionPct%; background-color: #9b1c1c;"></div>
                                </div>
                                <span class="progress-pct">@collectionPct%</span>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>

<div class="card" style="margin-bottom: 2rem;">
    <div class="card-header">
        <h3 style="margin: 0;">Regional Distribution</h3>
    </div>
    <div class="card-body">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Region</th>
                        <th>Number of Sites</th>
                        <th>Total Value</th>
                        <th>Avg Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model.GroupBy(j => j.Location))
                    {
                        <tr>
                            <td>@group.Key</td>
                            <td>@group.Count()</td>
                            <td>R @group.Sum(j => j.EstimatedCost).ToString("N0")</td>
                            <td>@(group.Any() ? (int)group.Average(j => j.Progress) : 0)%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div style="text-align: right; margin-bottom: 2rem;">
    <a href="/Dashboard/PortfolioView" class="btn btn-secondary">View Full Portfolio</a>
</div>
