@{
    ViewData["Title"] = "Set Up MFA";
    Layout = null;

    var qrCodeImage = ViewData["QrCodeImage"] as string;
    var authenticatorKey = ViewData["AuthenticatorKey"] as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Set Up MFA — Ubuhlebethu ConnectPro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="icon"
          type="image/png"
          href="~/images/logo.png" />
</head>

<body class="login-page">

    <div class="login-shell">

        <!-- Brand Panel -->
        <div class="login-brand">

            <div class="login-brand-logo">

                <div class="login-brand-mark"
                     style="background: transparent;">

                    <img src="~/images/logo.png"
                         alt="Ubuhlebethu Logo"
                         style="width:100%;height:100%;object-fit:contain;" />

                </div>

                <div class="login-brand-name">
                    Ubuhlebethu
                    <small>ConnectPro</small>
                </div>

            </div>

            <div class="login-tagline">
                Secure<br />
                Construction<br />
                <em>Management</em>
            </div>

            <p class="login-desc">
                Protect your ConnectPro account with
                multi-factor authentication.
            </p>

        </div>


        <!-- Form Panel -->
        <div class="login-form-panel">

            <div class="login-form-inner">

                <div class="login-form-title">
                    Set up MFA
                </div>

                <div class="login-form-sub">
                    Add an authenticator app to protect your account.
                </div>


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error">

                        @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                        {
                            <div>@error.ErrorMessage</div>
                        }

                    </div>
                }


                <div style="margin-top:24px;">

                    <h4>Step 1 — Scan the QR code</h4>

                    <p style="color:var(--text-muted);font-size:0.9rem;">
                        Open an authenticator app on your phone and
                        scan the QR code below.
                    </p>

                    @if (!string.IsNullOrEmpty(qrCodeImage))
                    {
                        <div style="
                            display:flex;
                            justify-content:center;
                            margin:24px 0;">

                            <div style="
                                background:white;
                                padding:16px;
                                border-radius:12px;
                                border:1px solid #e5e7eb;">

                                <img src="data:image/png;base64,@qrCodeImage"
                                     alt="MFA QR Code"
                                     style="width:220px;height:220px;" />

                            </div>

                        </div>
                    }

                </div>


                <div style="margin-top:24px;">

                    <h4>Step 2 — Enter the verification code</h4>

                    <p style="
                        color:var(--text-muted);
                        font-size:0.9rem;">

                        Enter the 6-digit code currently shown
                        by your authenticator app.

                    </p>

                </div>


                <form method="post"
                      asp-controller="Account"
                      asp-action="EnableMfa">

                    @Html.AntiForgeryToken()

                    <div class="form-group">

                        <label for="code"
                               class="form-label">
                            Authentication code
                        </label>

                        <input type="text"
                               id="code"
                               name="code"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               pattern="[0-9]{6}"
                               placeholder="123456"
                               required />

                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100"
                            style="margin-top:8px;padding:10px;">

                        Enable MFA

                    </button>

                </form>


                <div style="
                    margin-top:20px;
                    padding:14px;
                    background:#f8fafc;
                    border-radius:8px;
                    font-size:0.8rem;
                    color:var(--text-muted);">

                    <strong>Can't scan the QR code?</strong>

                    <br />

                    Enter this setup key manually in your
                    authenticator app:

                    <div style="
                        margin-top:8px;
                        font-family:monospace;
                        font-weight:600;
                        word-break:break-all;">

                        @authenticatorKey

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>
</html>
