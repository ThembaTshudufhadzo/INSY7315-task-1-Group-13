@using UbuhlebethuConnectPro.Web.Data
@inject ApplicationDbContext Db

@{
    var username = User?.Identity?.Name ?? string.Empty;
    var unreadCount = 0;
    List<UbuhlebethuConnectPro.Web.Models.Notification> recent = new();
    try
    {
        unreadCount = Db.Notifications.Count(n => n.UserId == username && !n.IsRead);
        recent = Db.Notifications.Where(n => n.UserId == username).OrderByDescending(n => n.CreatedAt).Take(5).ToList();
    }
    catch { }
}

<div class="dropdown" style="position:relative;">
    <div class="topbar-icon-btn" onclick="toggleDropdown('notifDrop')" title="Notifications" style="cursor:pointer;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 01-3.46 0"/>
        </svg>
        @if (unreadCount > 0)
        {
            <span class="topbar-badge">@unreadCount</span>
        }
    </div>

    <div class="dropdown-menu notif-dropdown" id="notifDrop" style="right:0; min-width:300px;">
        <div class="dropdown-header">
            Notifications
            @if (unreadCount > 0)
            {
                <span class="badge badge-danger" style="margin-left:6px;">@unreadCount new</span>
            }
        </div>
        @if (recent.Any())
        {
            @foreach (var n in recent)
            {
                <div class="notif-item @(n.IsRead ? "" : "unread")"
                     onclick="handleNotificationClick(event, @n.Id)"
                     style="cursor:pointer;">
                    <div class="notif-time">@n.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</div>
                    <div class="notif-msg">@n.Message</div>
                </div>
            }
        }
        else
        {
            <div class="notif-item">
                <div class="notif-msg" style="color: var(--text-muted);">No notifications</div>
            </div>
        }
        <div class="dropdown-divider"></div>
        <a class="dropdown-item" asp-controller="Notifications" asp-action="Index"
           style="justify-content:center; font-size:0.75rem; font-weight:600;">
            View all notifications
        </a>
    </div>
</div>

<script>
    function handleNotificationClick(e, id) {
        e.stopPropagation();
        fetch('/Notifications/MarkRead?id=' + id, { method: 'POST' })
            .then(r => {
                if (r.ok) {
                    window.location.href = '/Notifications/Index';
                }
            });
    }
</script>
