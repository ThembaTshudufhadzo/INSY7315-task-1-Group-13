@model IEnumerable<UbuhlebethuConnectPro.Web.Models.Notification>

@if (Model != null && Model.Any())
{
    <ul class="list-group list-group-flush">
    @foreach (var n in Model)
    {
        <li class="list-group-item d-flex justify-content-between align-items-start">
            <div>
                <div class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("g")</div>
                <div class="@(n.IsRead ? "" : "fw-bold")">@n.Message</div>
            </div>
            <div>
                <button class="btn btn-sm btn-link" onclick="markNotification(@n.Id)">Mark read</button>
            </div>
        </li>
    }
    </ul>
}
else
{
    <div class="p-3 text-muted">No notifications found.</div>
}
