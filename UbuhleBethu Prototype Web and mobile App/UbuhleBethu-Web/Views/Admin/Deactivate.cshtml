@model string
@{
    ViewData["Title"] = "Deactivate User";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Deactivate User Account</h1>
        <p class="page-subtitle">Temporarily suspend access for this user</p>
    </div>
    <div class="page-actions">
        <a asp-action="SystemSettings" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;margin-right:6px;">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            System Settings
        </a>
    </div>
</div>

<div class="card p-24" style="max-width:500px;">
    <div style="margin-bottom:20px;">
        <h3 style="color:var(--color-danger); font-size:1.1rem; margin-bottom:8px;">Warning</h3>
        <p style="font-size:0.9rem; color:var(--text-muted);">
            Are you sure you want to deactivate <strong>@Model</strong>? They will no longer be able to log in to the system until reactivated.
        </p>
    </div>
    
    <div style="display:flex; gap:12px;">
        <button class="btn btn-action-red" onclick="alert('User deactivated.')">Confirm Deactivate</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</div>
