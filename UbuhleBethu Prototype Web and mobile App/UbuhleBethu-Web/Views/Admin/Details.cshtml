@model UbuhlebethuConnectPro.Web.Controllers.AdminUserViewModel
@{
    ViewData["Title"] = "User Details";
    var lockout = ViewBag.LockoutEnd as System.DateTimeOffset?;
}

<h2>User Details</h2>

<div class="card mb-3">
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <p><strong>Username:</strong> @Model.UserName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Roles:</strong> @string.Join(", ", Model.Roles)</p>
        <p><strong>Locked Out:</strong> @(lockout.HasValue ? "Yes" : "No")</p>
        @if (lockout.HasValue)
        {
            <p><strong>Lockout End:</strong> @lockout.Value.ToLocalTime().ToString("g")</p>
        }
    </div>
</div>

@* Inline recent audit logs *@
@if (Model.AuditLogs != null && Model.AuditLogs.Any())
{
    <div class="card mb-3">
        <div class="card-header">Recent Audit Events (latest 20)</div>
        <div class="card-body p-0">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>When (UTC)</th>
                        <th>Action</th>
                        <th>By</th>
                        <th>Reason</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.AuditLogs)
                    {
                        <tr>
                            <td>@l.Timestamp.ToString("g")</td>
                            <td>@l.ActionType</td>
                            <td>@l.PerformedBy</td>
                            <td>@l.Reason</td>
                            <td>@l.Details</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="d-flex gap-2">
    <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#deactivateModal">Deactivate (Lockout)</button>

    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#reactivateModal">Reactivate</button>

    <a asp-action="EditRoles" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit Roles</a>
    <a asp-action="AuditLogs" class="btn btn-outline-secondary">View Audit Logs</a>
    <a asp-action="Index" class="btn btn-link">Back</a>
</div>

@* Reactivate confirmation modal *@
<div class="modal fade" id="reactivateModal" tabindex="-1" aria-labelledby="reactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Reactivate">
                <div class="modal-header">
                    <h5 class="modal-title" id="reactivateModalLabel">Confirm Reactivate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="reasonReactivate" class="form-label">Reason (optional, max 500 chars)</label>
                        <textarea id="reasonReactivate" name="reason" class="form-control" rows="3" maxlength="500" placeholder="Optional reason for reactivation"></textarea>
                        <div class="form-text">This reason will be stored in the audit log.</div>
                    </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Confirm Reactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Deactivate confirmation modal *@
<div class="modal fade" id="deactivateModal" tabindex="-1" aria-labelledby="deactivateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Deactivate">
                <div class="modal-header">
                    <h5 class="modal-title" id="deactivateModalLabel">Confirm Deactivate</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="reasonModal" class="form-label">Reason (optional, max 500 chars)</label>
                        <textarea id="reasonModal" name="reason" class="form-control" rows="3" maxlength="500" placeholder="Why are you deactivating this user?"></textarea>
                        <div class="form-text">This reason will be stored in the audit log.</div>
                    </div>
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Confirm Deactivate</button>
                </div>
            </form>
        </div>
    </div>
</div>
