@model IEnumerable<UbuhlebethuConnectPro.Web.Controllers.AdminUserViewModel>
@{
    ViewData["Title"] = "User Management";
}

<div class="page-header">
    <div>
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Administer system access and roles</p>
    </div>
    <div class="page-actions">
        <a asp-action="AuditLogs" class="btn btn-secondary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;margin-right:6px;">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            Audit Log
        </a>
    </div>
</div>
<div class="data-table-wrap">
    <div class="data-table-header">
        <p class="data-table-title">System Users</p>
        <div class="table-controls">
            <form method="get" class="d-flex align-items-center gap-2 m-0">
                <div class="table-search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search username or email..." />
                </div>
                <select name="role" class="form-select form-select-sm" style="width:auto; min-width: 140px; border: 1px solid var(--border-color); border-radius: 4px; padding: 6px 12px; font-size: 0.85rem;">
                    <option value="">All Roles</option>
                    @foreach(var r in (List<string>)ViewBag.AvailableRoles)
                    {
                        if(ViewBag.Role == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
                <button class="btn btn-primary" style="padding: 6px 16px; font-size: 0.85rem;">Filter</button>
                <a asp-action="ExportUsers" class="btn btn-outline-secondary" style="padding: 6px 16px; font-size: 0.85rem;">Export CSV</a>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table" style="width: 100%; text-align: left; border-collapse: collapse;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-secondary); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <th style="padding: 16px 20px; font-weight: 600;">User</th>
                    <th style="padding: 16px 20px; font-weight: 600;">Email</th>
                    <th style="padding: 16px 20px; font-weight: 600;">Roles</th>
                    <th style="padding: 16px 20px; font-weight: 600; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach(var u in Model)
            {
                <tr style="border-bottom: 1px solid var(--border-color); transition: background 0.2s ease;">
                    <td style="padding: 16px 20px; color: var(--text-main); font-weight: 500;">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <div style="width:32px; height:32px; border-radius:50%; background:var(--bg-accent); display:flex; align-items:center; justify-content:center; color:var(--text-main); font-size:0.75rem; font-weight:600;">
                                @(u.UserName.Substring(0, Math.Min(2, u.UserName.Length)).ToUpper())
                            </div>
                            @u.UserName
                        </div>
                    </td>
                    <td style="padding: 16px 20px; color: var(--text-secondary); font-size: 0.9rem;">@u.Email</td>
                    <td style="padding: 16px 20px;">
                        @foreach(var role in u.Roles)
                        {
                            <span class="badge badge-neutral" style="margin-right: 4px;">@role</span>
                        }
                    </td>
                    <td style="padding: 16px 20px; text-align: right;">
                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-outline-secondary" style="padding: 4px 12px; font-size: 0.8rem; margin-right: 8px;">Details</a>
                        <a asp-action="EditRoles" asp-route-id="@u.Id" class="btn btn-primary" style="padding: 4px 12px; font-size: 0.8rem;">Edit Roles</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
