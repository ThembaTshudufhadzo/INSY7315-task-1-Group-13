@{
    ViewData["Title"] = "System Settings";
}

<div class="page-header">
    <div>
        <h1 class="page-title">System Settings</h1>
        <p class="page-subtitle">Configure global application parameters, security, and integration options.</p>
    </div>
</div>

<div class="data-table-wrap" style="max-width: 800px; margin: 0 auto; padding: 24px;">
    
    <div style="border-bottom: 1px solid var(--border-color); margin-bottom: 24px; padding-bottom: 24px;">
        <h4 style="margin-top: 0; color: var(--text-main); font-weight: 600; margin-bottom: 8px;">Security & Authentication</h4>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">Manage password policies and multi-factor authentication requirements.</p>
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <div>
                <div style="font-weight: 500; font-size: 0.9rem;">Require Two-Factor Authentication (2FA)</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Enforce 2FA for all Admin and Management roles.</div>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked style="cursor: pointer; width: 40px; height: 20px;">
            </div>
        </div>
        
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div>
                <div style="font-weight: 500; font-size: 0.9rem;">Strict Password Policy</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">Require uppercase, numbers, and special characters.</div>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" checked style="cursor: pointer; width: 40px; height: 20px;">
            </div>
        </div>
    </div>

    <div style="border-bottom: 1px solid var(--border-color); margin-bottom: 24px; padding-bottom: 24px;">
        <h4 style="margin-top: 0; color: var(--text-main); font-weight: 600; margin-bottom: 8px;">System Maintenance</h4>
        <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">Configure automatic backups and retention policies.</p>
        
        <div class="mb-3">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 500; color: var(--text-secondary);">Audit Log Retention</label>
            <select class="form-select">
                <option>30 Days</option>
                <option>90 Days</option>
                <option selected>1 Year</option>
                <option>Indefinitely</option>
            </select>
        </div>
        
        <div class="mb-3">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 500; color: var(--text-secondary);">Daily Backup Time</label>
            <input type="time" class="form-control" value="02:00" />
        </div>
    </div>

    <div style="text-align: right;">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button class="btn btn-primary ms-2" onclick="showToast('Settings saved successfully')">Save Changes</button>
    </div>

</div>
