@model UbuhlebethuConnectPro.Web.Controllers.EditRolesViewModel
@{
    ViewData["Title"] = "Edit Roles";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Roles for @Model.UserName</h1>
        <p class="page-subtitle">Manage user access and permissions</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-secondary" onclick="alert('Exporting user log...')">Export Log</button>
        <a asp-action="Deactivate" asp-route-id="@Model.UserId" class="btn btn-action-red">Deactivate</a>
    </div>
</div>

<form method="post" asp-action="EditRoles">
    <input type="hidden" name="UserId" value="@Model.UserId" />
    <table class="table">
        <thead><tr><th>Role</th><th>Assigned</th></tr></thead>
        <tbody>
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <tr>
                <td>@Model.Roles[i].RoleName</td>
                <td>
                    <input type="checkbox" name="Roles[@i].Selected" value="true" @(Model.Roles[i].Selected ? "checked" : "") />
                    <input type="hidden" name="Roles[@i].RoleName" value="@Model.Roles[i].RoleName" />
                </td>
            </tr>
        }
        </tbody>
    </table>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
